{
  "name": "driftkv",
  "version": "0.4.0",
  "description": "Drift — a zero-dependency embedded key-value store for Node.js with TTL, LRU eviction, and optional JSON persistence.",
  "keywords": [
    "key-value",
    "kv",
    "store",
    "cache",
    "ttl",
    "lru",
    "embedded",
    "persistence",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Polaris Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenny-io/driftkv.git"
  },
  "homepage": "https://github.com/kenny-io/driftkv#readme",
  "bugs": {
    "url": "https://github.com/kenny-io/driftkv/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
